#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

if [ ! -f "$PROJECT_DIR/.env" ]; then
    echo "Erro: arquivo .env não encontrado em $PROJECT_DIR"
    echo "Copie o .env.exemplo para .env e ajuste usuário e senha do seu MySQL."
    exit 1
fi

# Lê o .env linha por linha em vez de usar "source", para que caracteres
# como & na DB_URL não sejam interpretados pelo shell. Aceita valores com ou
# sem aspas, ignora linhas vazias e comentários (#) e finais de linha do Windows.
while IFS= read -r linha || [ -n "$linha" ]; do
    linha="${linha%$'\r'}"
    case "$linha" in
        ''|\#*) continue ;;
    esac
    chave="${linha%%=*}"
    valor="${linha#*=}"
    valor="${valor%\"}"; valor="${valor#\"}"
    valor="${valor%\'}"; valor="${valor#\'}"
    export "$chave=$valor"
done < "$PROJECT_DIR/.env"

cd "$PROJECT_DIR"

#./mvnw spring-boot:run
mvn org.springframework.boot:spring-boot-maven-plugin:3.5.6:run